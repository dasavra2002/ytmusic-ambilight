{
  "manifest_version": 3,
  "name": "Ambient Light for YouTube Music™",
  "version": "1.0.0",
  "description": "Immersive real-time Ambilight glow for YouTube Music. Synchronizes with music videos and album art.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Music Ambilight Settings"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmusic-ambilight@antigravity.local",
      "strict_min_version": "109.0"
    },
    "safari": {
      "strict_min_version": "15.4"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
